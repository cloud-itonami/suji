[{:db/id -1, :suji.lex.muscleTension/lexicon 1, :suji.lex.muscleTension/id "com.etzhayyim.suji.muscleTension", :suji.lex.muscleTension/defs "{:main {:type \"record\", :key \"muscleId\", :record {:type \"object\", :comment \"G1 NON-DIAGNOSTIC (医師法 §17): a %MVC is a force ratio. `group` names the anatomical STRUCTURE and `side` names which of the body's two sides it is — one fact each. Before 2026-09-07 `group` carried both concatenated (\\\"upper-trapezius/left\\\"), which turned this enum from a vocabulary of mechanical structures into a list of modelled instances that grew by two every time a muscle was made bilateral. `forceN`/`mvcPct` are present together or not at all: a REFUSED muscle has neither (the model declined to compute a force) and a LIGAMENT has no mvcPct because it cannot contract, so there is no maximum voluntary contraction for it to be a fraction of. Values are EDN keyword literals, written exactly as the datom log writes them.\", :required [\"muscleId\" \"postureId\" \"group\" \"side\"], :additionalProperties false, :properties {:muscleId {:type \"string\"}, :postureId {:type \"string\"}, :group {:type \"string\", :enum [\":anterior-deltoid\" \":biceps-brachii\" \":brachialis\" \":cervical-extensors\" \":erector-spinae\" \":gastrocnemius\" \":gluteus-maximus\" \":hamstrings\" \":iliopsoas\" \":latissimus-dorsi\" \":levator-scapulae\" \":middle-deltoid\" \":middle-trapezius\" \":nuchal-ligament\" \":obliques\" \":posterior-lumbar-ligaments\" \":quadratus-lumborum\" \":rectus-femoris\" \":scalenes\" \":semispinalis-capitis\" \":soleus\" \":splenius-capitis\" \":sternocleidomastoid\" \":tibialis-anterior\" \":triceps-brachii\" \":upper-trapezius\" \":vasti\" \":wrist-extensors\" \":wrist-flexors\"], :description \"G10 — mechanically defined muscle groups only; NO 経絡/気/波動 (kizashi N8). The structure, without the side.\"}, :side {:type \"string\", :enum [\":left\" \":right\" \":midline\"], :description \"which of the body's two sides this instance is; :midline for the unpaired groups (cervical extensors, erector spinae, the ligaments)\"}, :forceN {:type \"number\", :description \"Hill-type muscle force = joint moment / moment arm; absent when the model refused this muscle\"}, :mvcPct {:type \"number\", :description \"緊張 — percent of max voluntary contraction; a force ratio, never a diagnosis (G1). ABSENT, not zero and not a sentinel, when there is no number: see `refused`.\"}, :refused {:type \"string\", :enum [\":none\" \":acts-the-wrong-way\" \":coefficient-below-floor\" \":no-line-of-action\" \":no-usable-synergist\" \":contact-would-pull\"], :description \"present only when there is no mvcPct, and says why. `:none` is NOT a refusal — it means this is a ligament, which cannot contract and therefore has no %MVC to report.\"}, :antagonist {:type \"boolean\", :description \"refused because its opposite number is carrying this instant's load\"}}}}}"}]
